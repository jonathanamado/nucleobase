# =========================================================
# CONTROLE FINANCEIRO - GITIGNORE COMPLETO
# =========================================================

# --- Dependências e Build (Next.js / Node) ---
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
/.next/
/out/
/build
.vercel

# --- Debug e Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/coverage
.DS_Store
*.pem

# --- Ambiente e Typescript ---
.env*
*.tsbuildinfo
next-env.d.ts

# =========================================================
# CONFIGURAÇÕES STREAMLIT E SEGURANÇA (CRÍTICO)
# =========================================================

# 🔒 Ignora segredos locais (Senhas do Banco e Supabase)
.streamlit/secrets.toml

# Ignora configurações locais do Streamlit
.streamlit/config.toml

# =========================================================
# PYTHON E ARQUIVOS TEMPORÁRIOS
# =========================================================

# Ignora arquivos compilados do Python
__pycache__/
*.pyc
*.pyo
*.pyd
.ipynb_checkpoints/

# Ignora ambientes virtuais locais (caso existam)
venv/
.venv/
env/

# =========================================================
# DADOS LOCAIS E BACKUPS (MANTÉM O REPOSITÓRIO LIMPO)
# =========================================================

# 📂 Ignora arquivos de dados locais (JSON e pastas de projetos)
data/*.json
data/*.csv
projetos/

# Ignora arquivos temporários do Excel/Word (os que começam com ~$)
~$*.xlsx
~$*.xls

# Sentry Config File
.env.sentry-build-plugin
